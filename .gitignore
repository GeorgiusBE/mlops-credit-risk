# Local datasets and generated outputs
# ?* requires a nonempty child name so DVC can discover directories ending in /.
/dataset/?*
!/dataset/raw/
!/dataset/processed/
/dataset/raw/?*
!/dataset/raw/*.dvc
!/dataset/raw/.gitignore
!/dataset/raw/training_schema.drawio
/dataset/processed/?*
!/dataset/processed/*.dvc
!/dataset/processed/.gitignore

# Virtual environments and local configuration
.env
.env.*
!.env.example
.venv/
venv/

# Python and Jupyter caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Test, coverage, and tooling outputs
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Local MLflow metadata, artifacts, and server logs
/.mlflow/
/mlruns/
/mlartifacts/
/mlflow.db*
